---
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
---
<Base
  title="404 · San Lee"
  robots="noindex"
>
  <Fragment slot="head">
  <style is:inline>
    /* Missing-page plate (portfolio ADR-004). Asked path, empty record.
       Dashed box + oxide NOT LOGGED. viewBox 1:1.

       The plate now sits in the MONOGRAPH figure ladder (ADR-014). The
       wrapper is the .fig fig--plate div, so style.css owns the width cap
       (--fig-plate), the night ground, the pocket edition, and the owned
       margin. The four declarations that stated those here are DELETED
       rather than out-cascaded, per the ladder's own rule. What stays is
       page-scoped: the stroke, the fill, and the type inside this one
       drawing.

       This plate carries NO figure label, and that is a recorded call, not
       an oversight. A number indexes a figure so a reader can cite it, and
       this page is a joke page behind robots="noindex" that nobody cites.
       The floor duty is separate and it still binds: see .ms-micro below. */
    /* The box stroke reads --stroke-figure, not --rule-strong (ADR-014,
       amendment A2). The two tokens are the same hex in light. In dark the
       figure token is #b0a591 against the global rule's #6b6252, so the
       night retune reaches the plate and leaves every rule outside the
       figure layer at its July value. I0 moved the two prototype pages'
       plates and left each remaining page's plate to that page's lane.
       fill: var(--bg) is deliberate and unchanged: --bg is scoped to
       --fig-ground inside a dark figure, so the knockout tracks the lifted
       ground instead of punching a darker hole in it. The dashed .ms-hollow
       and the .ms-edge arrows keep --muted: they are the quiet rank, and
       PL-10 pins the RANK ink > strong > quiet, not the hex. */
    .miss-plate .ms-box {
      fill: var(--bg);
      stroke: var(--stroke-figure);
      stroke-width: 1;
    }
    .miss-plate .ms-hollow {
      fill: var(--bg);
      stroke: var(--muted);
      stroke-width: 1.5;
      stroke-dasharray: 4 3;
    }
    .miss-plate .ms-lane {
      fill: var(--muted);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    .miss-plate .ms-title {
      fill: var(--text);
      font-family: var(--font);
      font-size: 11px;
      font-weight: 500;
    }
    /* 9px, not 8px: the microtext floor (CLAUDE.md, ADR-014 section 5). The
       plate holds a 260-unit viewBox and renders at scale 1.046 in a 320px
       viewport, so a declared 9px renders at 9.42px. The rule says raise the
       declared unit and never scale the plate. The label "no entry" is
       byte-exact and it measures 43.4 units at 9px inside a 128-unit box. */
    .miss-plate .ms-micro {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 9px;
    }
    .miss-plate .ms-edge {
      fill: none;
      stroke: var(--muted);
      stroke-width: 1.5;
    }
    .miss-plate .ms-bad {
      fill: var(--accent-warm-soft);
      stroke: var(--accent-warm);
      stroke-width: 1.5;
    }
    .miss-plate .ms-bad-text {
      fill: var(--accent-warm);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    .miss-plate marker path { fill: var(--muted); }
    /* The caption now sits INSIDE the figure wrapper, so the PL-2 ladder in
       style.css does not reach it: the ladder owns direct children of
       main.wrap only. The old bottom margin is gone; the wrapper owns the
       air under the figure now.

       max-width and the auto margins RESTATE the consolidated .fig
       figcaption geometry, measured: without them the caption inherits the
       wrapper's promoted wide track and runs 884px at 1280px, against a
       544px prose measure. This caption cannot BE a <figcaption>, because a
       figcaption outside a <figure> is invalid and a <figure> here fails the
       figure contract. So it restates the one rule it cannot inherit, and
       nothing else. Consolidating this selector belongs to the one hand on
       style.css; the pull request records the ask. */
    .miss-plate-caption {
      color: var(--muted);
      font-size: 0.92rem;
      max-width: var(--content);
      margin: 14px auto 0;
    }
    /* The way-back rows are stacked link rows, so each link grows into its
       own 44px band below 900px — inline-block, the pitch-grows mechanism
       from the thumbable-links block in style.css. hit-target.cjs measures
       standalone anchors at 390px, so a regression here fails the build. */
    @media (max-width: 900px) {
      .way-back a {
        display: inline-block;
        padding: 12px 0;
      }
    }
  </style>
  </Fragment>

  <SiteNav />


  <main class="wrap article-body" id="main" tabindex="-1">
    <h1>404 &mdash; not in the record</h1>
    <p class="lead">
      This path is not on the site. The link is stale, or the path never
      existed.
    </p>
    <!-- The wrapper is a div and never a <figure>: figure-contract.cjs fails
         a <figure> that carries no data-fig, and a data-fig figure owes two
         caption slots this one-slot caption does not have. No fig-label
         here; the head of this style island records why. -->
    <div class="fig fig--plate">
    <svg class="miss-plate" viewBox="0 0 260 118" role="img"
         aria-label="The path you asked for is not in the record. No decision was logged for it.">
      <title>Asked path, empty record. Not logged.</title>
      <defs>
        <marker id="ms-arrow" viewBox="0 0 10 10" refX="9" refY="5"
                markerWidth="6" markerHeight="6" orient="auto" aria-hidden="true">
          <path d="M 0 0 L 10 5 L 0 10 z" />
        </marker>
      </defs>
      <text class="ms-lane" x="4" y="12">ASKED</text>
      <rect class="ms-box" x="4" y="18" width="100" height="36" rx="2" />
      <text class="ms-title" x="54" y="40" text-anchor="middle">a path</text>
      <path class="ms-edge" d="M 104 36 L 124 36" marker-end="url(#ms-arrow)" aria-hidden="true" />
      <text class="ms-lane" x="128" y="12">RECORD</text>
      <rect class="ms-hollow" x="128" y="18" width="128" height="36" rx="2" />
      <text class="ms-micro" x="192" y="40" text-anchor="middle">no entry</text>
      <rect class="ms-bad" x="4" y="66" width="252" height="28" rx="2" />
      <text class="ms-bad-text" x="130" y="84" text-anchor="middle">NOT LOGGED</text>
    </svg>
    <p class="miss-plate-caption">
      A stale link, or a path that never existed.
    </p>
    </div>
    <p>Here is the way back:</p>
    <ul class="way-back">
      <li><a href="/index.html">The front page</a></li>
      <li><a href="/projects/the-system.html">The System</a> &middot; <a href="/projects/defense-news-classifier.html">Defense News Classifier</a> &middot; <a href="/projects/product-and-program.html">Product &amp; Program</a></li>
      <li><a href="/glossary.html">Glossary</a> &middot; <a href="/colophon.html">Colophon</a> &middot; <a href="/resume.html">Résumé</a></li>
    </ul>
  </main>
  <script is:inline src="/assets/theme.js"></script>
</Base>
