---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
---
<Base
  title="Scroll-driven storytelling · San Lee"
  description="A sticky panel and scroll-scrubbed reveals, built with CSS only. No JavaScript."
  canonical="https://sanlee.me/lab/scroll-storytelling.html"
  ogType="article"
>
  <Fragment slot="head">
  <style is:inline>
    /* ---- Experiment-specific CSS (kept out of the global stylesheet) ---- */

    /* 1) STICKY PANEL: the left panel pins while the right column scrolls past. */
    .story {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      max-width: var(--maxw);
      margin: 0 auto;
      padding: 0 24px 30vh;
    }
    .story-sticky {
      position: sticky;
      top: 22vh;
      /* CRITICAL: in a grid/flex, items stretch to fill the track by default,
         which breaks sticky. align-self:start lets it be its natural height so
         it has room to stick. */
      align-self: start;
      padding: 28px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--panel);
    }
    .story-sticky h2 { margin: 0 0 10px; }
    .story-sticky p { margin: 0; color: var(--muted); }
    .story-step {
      min-height: 70vh;
      display: flex;
      align-items: center;
      font-size: 1.4rem;
      color: var(--text);
      border-bottom: 1px solid var(--border);
    }

    /* On a phone the two columns collapse to ~150px each and the panel text
       breaks one word per line. Stack to a single column: the sticky panel
       pins at the top and the steps scroll beneath it, which still demonstrates
       position: sticky — just vertically instead of side-by-side. */
    @media (max-width: 640px) {
      .story { grid-template-columns: 1fr; gap: 8px; }
      .story-sticky { top: 12vh; margin-bottom: 8px; }
      .story-step { min-height: 60vh; font-size: 1.25rem; }
    }

    /* 2) SCROLL-SCRUBBED REVEALS: each block animates as it ENTERS the viewport,
       scrubbed by scroll position (animation-timeline: view()), no JS. */
    .scrub-section { max-width: var(--maxw); margin: 0 auto; padding: 20vh 24px; }
    .scrub-item {
      padding: 30px;
      margin-bottom: 18px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--panel);
      font-size: 1.2rem;
    }

    /* Progressive enhancement: WITHOUT scroll-timeline support, items are just
       visible. WITH support, they scrub in as they enter the viewport. */
    @supports (animation-timeline: view()) {
      .scrub-item {
        animation: scrub-in linear both;
        animation-timeline: view();
        /* run the animation over the element's ENTRY into the scrollport */
        animation-range: entry 0% entry 100%;
      }
    }
    @keyframes scrub-in {
      from { opacity: 0; transform: translateY(40px) scale(0.96); }
      to   { opacity: 1; transform: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      .scrub-item { animation: none; opacity: 1; transform: none; }
    }
  </style>
  </Fragment>


  <SiteNav current="work" />


  <main class="wrap article-body" id="main" tabindex="-1">
    <a class="back" href="../index.html">&larr; Back to portfolio</a>
    <h1>Scroll-driven storytelling</h1>
    <p class="subtitle">
      Two native techniques, zero JavaScript: a <code>position: sticky</code> panel
      that pins while content scrolls past it, and <code>animation-timeline: view()</code>
      reveals that scrub as elements enter the viewport. Scroll down.
    </p>
  </main>

  <!-- STICKY PANEL DEMO -->
  <section class="story">
    <div class="story-sticky">
      <h2>This panel sticks</h2>
      <p>It pins in place while the steps scroll past it, then releases
         at the bottom of the section. That's <code>position: sticky</code>.</p>
    </div>
    <div class="story-scroll">
      <div class="story-step">Step one. Scroll on.</div>
      <div class="story-step">Step two. The panel is still pinned.</div>
      <div class="story-step">Step three. About to release.</div>
    </div>
  </section>

  <!-- SCROLL-SCRUBBED REVEALS -->
  <section class="scrub-section">
    <div class="scrub-item">I fade and rise as I enter, scrubbed by scroll.</div>
    <div class="scrub-item">Scroll up a little and I animate back. It's reversible.</div>
    <div class="scrub-item">No IntersectionObserver, no JS, just a pure CSS timeline.</div>
    <div class="scrub-item">The animation's progress IS my position in the viewport.</div>
  </section>

  <script is:inline src="../assets/theme.js"></script>
  <script is:inline src="../assets/last-updated.js"></script>
</Base>
