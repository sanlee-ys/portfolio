---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import figures from '../../data/figures.json';

/* The plot geometry. scripts/build-plots.cjs computed every number below from a
   named artifact at a pinned commit, and this page interpolates it. The page
   types no coordinate and no count, so the marks cannot drift from the
   measurement. `discordant.artifact` and `discordant.sha` also fill the caption,
   so the provenance line cannot disagree with the geometry above it. */
const discordant = figures.plots?.['fj2-discordant'];
if (!discordant) {
  throw new Error(
    'faithfulness-judge: src/data/figures.json holds no "fj2-discordant" plot. '
    + 'Run: node scripts/build-plots.cjs --repo=<path to faithfulness-judge> '
    + '--repo=<path to defense-news-classifier>'
  );
}
const dp = discordant.geometry;
const dpCommit = discordant.sha.slice(0, 7);
const dpValue = (label) => {
  const found = discordant.values.find((v) => v.label === label);
  if (!found) {
    throw new Error(`faithfulness-judge: the "fj2-discordant" plot holds no "${label}" value.`);
  }
  return found.value;
};
const dpN = dpValue('paired claims');
const dpWins = dpValue('premium right, cheap wrong');
const dpLosses = dpValue('cheap right, premium wrong');
/* The artifact carries four decimal places and this page has always published
   two. The rounding happens here rather than in the caption text, so the
   published figure is derived from the artifact and never typed. */
const dpP = dpValue('McNemar exact p').toFixed(2);
/* One mark per discordant pair is the whole argument of fj2, and the mark list
   and the count come from two separate fields of one record. Nothing else ties
   them together. A record whose geometry and whose values disagree would
   publish a wrong count as a row length, and no gate reads an SVG rect. So
   check the invariant here and fail the build. */
if (dp.winsX.length !== dpWins || dp.lossesX.length !== dpLosses) {
  throw new Error(
    'faithfulness-judge: the "fj2-discordant" geometry and its values disagree. '
    + `winsX holds ${dp.winsX.length} marks against a count of ${dpWins}. `
    + `lossesX holds ${dp.lossesX.length} marks against a count of ${dpLosses}. `
    + 'Re-run: node scripts/build-plots.cjs --repo=<path to faithfulness-judge>'
  );
}
---
<Base
  title="Evaluating an LLM Faithfulness Judge · San Lee"
  description="I measured an LLM-as-judge on 193 hand-labeled claims from public defense text. A token-limit bug created a false model-tier gap."
  canonical="https://sanlee.me/projects/faithfulness-judge.html"
  ogType="article"
  ogImage="/assets/og-faithfulness-judge.png"
>
  <Fragment slot="head">
  <style is:inline>
    /* THE CAPTION GRAMMAR IS GONE FROM THIS PAGE (ADR-014, MONOGRAPH).

       The two-slot caption block that stood here was a verbatim copy of
       src/pages/projects/context-architecture.astro at 9d81caa, kept as a copy
       because a concurrent session owned public/assets/style.css and two
       writers on one shared stylesheet cannot merge. That session merged and
       the integrator gave the grammar one home, so the copy and its origin
       comment are DELETED rather than out-cascaded. style.css now owns
       `.fig figcaption`, `.fig-what`, `.fig-limit`, the global `figcaption a`
       rule, and `figcaption code { overflow-wrap: anywhere }`, which is the
       rule this page needed for the artifact path in the fj2 caption.

       One page-local rule survives that deletion, and only because style.css
       names the telltale caption class rather than these two: a bare plate on
       this page carries a single-paragraph caption, not a two-slot figcaption,
       so the paragraph is given the same measure and the same offset the
       figcaption block gives a caption. style.css owns the voice. */
    /* The bare-plate caption geometry moved to style.css (`.fig--plate > p`),
       so the two properties this page restated are deleted. */

    /* Two plates and one plot, one grammar (ADR-013). Page-scoped.

       WIDTH IS NO LONGER SET HERE. The figure ladder in style.css (ADR-014)
       carries display, width, height, the cap, and the centring for every
       plate through `figure[data-fig="plate"] > svg` and `.fig--plate > svg`,
       so the layout declarations this block used to hold are deleted. The
       ladder names --fig-plot but wires no plot selector, because no plot had
       landed when it shipped, so fj2 pins its own rung below.

       The shared parts carry an `fj-` prefix and the per-plate parts carry
       `fj1-` and `fj2-`. Neither figure needs a marker or a gradient, so this
       block adds no id to the document and cannot repaint another plate's
       arrow head.

       Both are monochrome. Oxide (--accent-warm) on this site marks a
       decision that was taken back, and the .judge-plate comment below records
       that reading for this page. Nothing here was taken back, so every state
       is a word plus a shape: a solid cell against a dashed cell on fj1, and a
       solid mark against a hollow mark on fj2.

       SVG text inherits from <body>, so every text class names its own font. */
    .fj-plate .fj-lane {
      fill: var(--muted);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    .fj-plate .fj-title {
      fill: var(--text);
      font-family: var(--font);
      font-size: 11px;
      font-weight: 500;
    }
    .fj-plate .fj-state {
      fill: var(--text);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    /* 9px, not 8px: the microtext floor (CLAUDE.md, ADR-014 section 5). No
       SVG text may render under 9px at a 320px viewport. The declared unit is
       raised at 1:1 rather than the plate scaled under a breakpoint, because a
       plate that grows only on a phone renders its text smaller again above
       that breakpoint. Measured on this page: 8.37px before, 9.42px after. */
    .fj-plate .fj-micro {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 9px;
    }

    /* fj1-nested. One outer set, two cells inside it.

       THE CELLS ARE NOT TO SCALE, and the caption says so. A hand-drawn
       plate that sized a cell by a count would publish that count as a width,
       with no producer and no gate. The counts stay in the caption, where
       a reader reads them.

       The dash is the shape for the least crisp call a labeler makes, which is
       the rubric's own word for the hedged class. The solid cell is the crisp
       one. */
    .fj1-plate .fj1-outer {
      fill: none;
      /* The figure layer's stroke rank (ADR-014 A2): --stroke-figure carries
         every strong plate stroke, so the night retune reaches this plate and
         no rule outside the figure layer moves. Light is unchanged. */
      stroke: var(--stroke-figure);
      stroke-width: 1;
    }
    .fj1-plate .fj1-crisp {
      fill: var(--bg);
      stroke: var(--text);
      stroke-width: 1.5;
    }
    .fj1-plate .fj1-soft {
      fill: var(--bg);
      stroke: var(--muted);
      stroke-width: 1.5;
      stroke-dasharray: 4 3;
    }

    /* fj2-discordant. THE ORIGIN COPY of the discordant-pair grammar.

       Three pages on this site run a paired comparison, and none of them showed
       the discordant pairs. This block is written here first. A later lane
       copies the rules below and the <figure> markup on the page, verbatim, and
       names this page and its commit in the copy's comment. This grammar stays
       a copy: it is one study's drawing, not a site-wide component, and
       style.css owns only what every page shares.

       WHAT A COPYING LANE CHANGES, AND NOTHING ELSE.
         1. The `fj2-` prefix becomes that page's own prefix.
         2. The two row labels become that comparison's two directions.
         3. The verdict word becomes that comparison's verdict.
         4. A NEW definition in the PLOTS registry of scripts/build-plots.cjs,
            with that page's own artifact, its own commit, and its own key. A
            copying page never reads `fj2-discordant`: these counts belong to
            this study.

       WHY THE MARKS ARE GENERATED. The count IS the geometry here: one mark per
       discordant pair. A typed row of marks is a published count with no
       producer, which is what ADR-013 refuses. build-plots.cjs reads the counts
       out of a pinned artifact and writes the x of every mark into
       src/data/figures.json, so a row cannot drift from the measurement.

       WHY THE TWO ROWS SHARE A LEFT EDGE. The reader compares two lengths, not
       two positions. The fill and the row label dual-encode the direction, so
       the plate needs no second hue.

       THE PLOT'S RUNG ON THE FIGURE LADDER. `data-place="sheet"` puts this
       figure on the wide track, which is the per-kind default for a plot
       (ADR-014). The ARTWORK cap is the plate rung and NOT --fig-plot, and
       that is a measured call rather than the default. The ladder's rungs are
       rendered widths, and each one was chosen against the artboard its kind
       usually draws on. This plot draws on a 260-unit artboard, the same one
       every plate on this page draws on. Measured at 1280px: --fig-plot
       renders it at 480px, so its 10-unit lane labels paint at 18.46px, and
       the body text beside them paints at 18.40px. A chrome label the size of
       the prose is not a chrome label. --fig-plate renders the same artboard
       at 384px and its lane labels at 14.77px, which is the scale the other
       three figures hold. */
    .fj2-plate {
      display: block;
      width: 100%;
      max-width: min(100%, var(--fig-plate));
      height: auto;
      margin-left: auto;
      margin-right: auto;
    }
    .fj2-plate .fj2-rule {
      stroke: var(--border);
      stroke-width: 1;
    }
    .fj2-plate .fj2-win {
      fill: var(--text);
      stroke: none;
    }
    .fj2-plate .fj2-loss {
      fill: var(--bg);
      stroke: var(--text);
      stroke-width: 1.5;
    }

    /* Claim-vs-source plate (portfolio ADR-004). Page-scoped: the unit of the
       study, not a metrics chart (the κ table already carries the numbers).
       The plate sits in a `.fig .fig--plate` wrapper now, so the figure ladder
       in style.css owns its width, its height, and its centring (ADR-014), and
       the 260px cap this block used to carry is deleted rather than
       out-cascaded. The wrapper also scopes --bg to the lifted dark figure
       ground, so every knockout rect below tracks that ground. */
    .judge-plate .jp-box {
      fill: var(--bg);
      /* The figure layer's stroke rank (ADR-014 A2). Light is unchanged. */
      stroke: var(--stroke-figure);
      stroke-width: 1;
    }
    .judge-plate .jp-lane {
      fill: var(--muted);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    .judge-plate .jp-title {
      fill: var(--text);
      font-family: var(--font);
      font-size: 11px;
      font-weight: 500;
    }
    /* 9px, not 8px: the microtext floor (CLAUDE.md, ADR-014 section 5).
       Measured on this page: 8.00px before, 9.42px after. */
    .judge-plate .jp-micro {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 9px;
    }
    /* Schematic passage marks — not a real quote, not UI chrome. */
    .judge-plate .jp-glyph {
      fill: none;
      stroke: var(--muted);
      stroke-width: 1.25;
      stroke-linecap: round;
    }
    .judge-plate .jp-edge {
      fill: none;
      stroke: var(--muted);
      stroke-width: 1.5;
    }
    /* Supported: ink solid — the ordinary pass. Dual-encoded by word + stroke. */
    .judge-plate .jp-ok {
      fill: var(--bg);
      stroke: var(--text);
      stroke-width: 1.5;
    }
    .judge-plate .jp-ok-text {
      fill: var(--text);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    /* Unsupported: oxide — the class the study is built to catch. Word + oxide
       dual-encode; not colour-only. Oxide is for the negative finding, same
       as .two-fail FAIL (not a "red means bad UI"). */
    .judge-plate .jp-bad {
      fill: var(--accent-warm-soft);
      stroke: var(--accent-warm);
      stroke-width: 1.5;
    }
    .judge-plate .jp-bad-text {
      fill: var(--accent-warm);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    .judge-plate marker path { fill: var(--muted); }

    /* Truncation plate: the false gap. Cheap tier cut before the verdict
       word; scoring counted each empty as a miss. Oxide on the false gap.
       Width, height, and centring come from the figure ladder in style.css
       through the `.fig .fig--plate` wrapper (ADR-014), as on .judge-plate. */
    .trunc-plate .tp-box {
      fill: var(--bg);
      /* The figure layer's stroke rank (ADR-014 A2). Light is unchanged. */
      stroke: var(--stroke-figure);
      stroke-width: 1;
    }
    .trunc-plate .tp-hollow {
      fill: var(--bg);
      stroke: var(--muted);
      stroke-width: 1.5;
      stroke-dasharray: 4 3;
    }
    .trunc-plate .tp-lane {
      fill: var(--muted);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    .trunc-plate .tp-title {
      fill: var(--text);
      font-family: var(--font);
      font-size: 11px;
      font-weight: 500;
    }
    /* 9px, not 8px: the microtext floor (CLAUDE.md, ADR-014 section 5).
       Measured on this page: 8.00px before, 9.42px after. */
    .trunc-plate .tp-micro {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 9px;
    }
    .trunc-plate .tp-edge {
      fill: none;
      stroke: var(--muted);
      stroke-width: 1.5;
    }
    .trunc-plate .tp-edge-break {
      fill: none;
      stroke: var(--accent-warm);
      stroke-width: 1.5;
      stroke-dasharray: 4 3;
    }
    .trunc-plate .tp-bad {
      fill: var(--accent-warm-soft);
      stroke: var(--accent-warm);
      stroke-width: 1.5;
    }
    .trunc-plate .tp-bad-text {
      fill: var(--accent-warm);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    .trunc-plate marker path { fill: var(--muted); }
    .trunc-plate marker path.tp-head-bad { fill: var(--accent-warm); }
  </style>
  </Fragment>

