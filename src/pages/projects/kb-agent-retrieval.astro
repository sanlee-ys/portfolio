  <Fragment slot="head">
  <style is:inline>
    /* Retrieval measured plate (portfolio ADR-004). Page-scoped: the unit is
       query → ranked chunks → objective gold path-match, not a metrics chart
       (the tables below carry the numbers). Max-width 260 keeps viewBox units
       1:1 with CSS px on every gate width (same measured discipline as
       .judge-plate / .two-fail / .lab-topo). */
    .retr-plate {
      display: block;
      width: 100%;
      max-width: 260px;
      height: auto;
      margin: 18px 0 6px;
    }
    .retr-plate .rp-box {
      fill: var(--bg);
      stroke: var(--rule-strong);
      stroke-width: 1;
    }
    .retr-plate .rp-lane {
      fill: var(--muted);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    .retr-plate .rp-title {
      fill: var(--text);
      font-family: var(--font);
      font-size: 11px;
      font-weight: 500;
    }
    .retr-plate .rp-micro {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 8px;
    }
    /* Rank rows: schematic list, not real chunk text. */
    .retr-plate .rp-rank {
      fill: none;
      stroke: var(--muted);
      stroke-width: 1.25;
