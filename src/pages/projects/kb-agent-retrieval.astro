    /* Retrieval measured plate (portfolio ADR-004). Page-scoped: the unit is
       query → ranked chunks → objective gold path-match, not a metrics chart
       (the tables below carry the numbers). Max-width 260 keeps viewBox units
       1:1 with CSS px on every gate width (same measured discipline as
       .judge-plate / .two-fail / .lab-topo). */
    .retr-plate {
      display: block;
      width: 100%;
      max-width: 260px;
      height: auto;
      margin: 18px 0 6px;
    }
    .retr-plate .rp-box {
      fill: var(--bg);
      stroke: var(--rule-strong);
      stroke-width: 1;
    }
    .retr-plate .rp-lane {
      fill: var(--muted);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    .retr-plate .rp-title {
      fill: var(--text);
      font-family: var(--font);
      font-size: 11px;
      font-weight: 500;
    }
    .retr-plate .rp-micro {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 8px;
    }
    /* Rank rows: schematic list, not real chunk text. */
    .retr-plate .rp-rank {
      fill: none;
      stroke: var(--muted);
      stroke-width: 1.25;
      stroke-linecap: round;
    }
    .retr-plate .rp-rank-num {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 9px;
    }
    .retr-plate .rp-edge {
      fill: none;
      stroke: var(--muted);
      stroke-width: 1.5;
    }
    /* Hit: ink solid — the ordinary path match. Dual-encoded by word + stroke. */
    .retr-plate .rp-hit {
      fill: var(--bg);
      stroke: var(--text);
      stroke-width: 1.5;
    }
    .retr-plate .rp-hit-text {
      fill: var(--text);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    /* Miss: oxide — the class the eval is built to surface. Word + oxide
       dual-encode; not colour-only. Same oxide-for-negative as .two-fail FAIL
       and .judge-plate UNSUPPORTED. */
    .retr-plate .rp-miss {
      fill: var(--accent-warm-soft);
      stroke: var(--accent-warm);
      stroke-width: 1.5;
    }
    .retr-plate .rp-miss-text {
      fill: var(--accent-warm);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    .retr-plate marker path { fill: var(--muted); }
    .retr-plate-caption {
      color: var(--muted);
      font-size: 0.92rem;
      margin: 0 0 6px;
    }

    /* Hybrid declined plate. MRR identical; the miss it was built for
