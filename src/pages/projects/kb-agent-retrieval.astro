---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import Term from '../../components/Term.astro';
import figures from '../../data/figures.json';

/* The plot geometry. scripts/build-plots.cjs computed every number below from a
   named artifact at a pinned commit, and this page interpolates it. The page
   types no coordinate and no count, so a mark cannot drift from the
   measurement. `quantum.artifact` and `quantum.sha` also fill the caption, so
   the provenance line cannot disagree with the geometry above it. */
const quantum = figures.plots?.['kb3-quantum'];
if (!quantum) {
  throw new Error(
    'kb-agent-retrieval: src/data/figures.json holds no "kb3-quantum" plot. '
    + 'Run: node scripts/build-plots.cjs --repo=<path to kb-agent> '
    + '--repo=<path to faithfulness-judge> --repo=<path to defense-news-classifier>'
  );
}
const qg = quantum.geometry;
const qCommit = quantum.sha.slice(0, 7);
const qValue = (label) => {
  const found = quantum.values.find((v) => v.label === label);
  if (!found) {
    throw new Error(`kb-agent-retrieval: the "kb3-quantum" plot holds no "${label}" value.`);
  }
  return found.value;
};
const qPairs = qValue('eligible pairs');
const qWins = qValue('hybrid right, dense wrong');
const qLosses = qValue('dense right, hybrid wrong');
const qPoints = qValue('points per query');
/* This page publishes the p-value at four decimal places, and the artifact
   carries four. The rounding happens here rather than in the caption text, so
   the published figure is derived from the artifact and never typed. */
const qP = qValue('McNemar exact p').toFixed(4);
---
<Base
  title="Measuring RAG Retrieval Quality with A/B Tests · San Lee"
  description="A 27-query gold set and three paired A/B tests measure kb-agent retrieval quality. The evidence decided against hybrid search as the default."
