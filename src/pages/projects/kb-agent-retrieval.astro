      stroke: var(--muted);
      stroke-width: 1.5;
      stroke-dasharray: 4 3;
    }
    .kb1-plate .kb1-want-text {
      fill: var(--muted);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
