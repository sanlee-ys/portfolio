      <svg class="nl3-devmode" viewBox="0 0 260 120" role="img"
           aria-label="A dependency chain. The script's last line re-arms the router. That line is gated behind the device-mode flag, and a factory board ships with the flag off. The flag needs physical confirmation at the device. No script can enter that last step.">
        <title>A dependency chain. The script's last line re-arms the router. That line is gated behind the device-mode flag, and a factory board ships with the flag off. The flag needs physical confirmation at the device. No script can enter that last step.</title>
        <defs>
          <marker id="nl3-head" viewBox="0 0 10 10" refX="9" refY="5"
                  markerWidth="6" markerHeight="6" orient="auto">
            <path d="M 0 0 L 10 5 L 0 10 z" />
          </marker>
        </defs>

        <rect class="nl3-box" x="2" y="2" width="256" height="26" rx="2" />
        <text class="nl3-step" x="130" y="19" text-anchor="middle">re-arm, the last line of the script</text>

        <path class="nl3-edge" d="M 130 28 L 130 36" marker-end="url(#nl3-head)" />

        <rect class="nl3-box" x="2" y="36" width="256" height="32" rx="2" />
        <text class="nl3-step" x="130" y="51" text-anchor="middle">gated behind the device-mode flag</text>
        <text class="nl3-sub" x="130" y="63" text-anchor="middle">off on a factory board</text>

        <path class="nl3-edge" d="M 130 68 L 130 76" marker-end="url(#nl3-head)" />

        <rect class="nl3-hand-box" x="2" y="76" width="256" height="32" rx="2" />
        <text class="nl3-step" x="130" y="91" text-anchor="middle">physical confirmation at the device</text>
