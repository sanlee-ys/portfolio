---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import evidence from '../../data/telltale-evidence.json';
/*
 * The record is read at render time in two places, and the two are protected
 * differently on purpose.
 *
 * FIGURES are typed into the markup as literals. `check-telltale-evidence.cjs`
 * then compares the rendered text to this file, so the gate does real work: a
 * mistyped count fails the build. Interpolating a figure here would make the
 * gate compare the record to itself, which is not a check.
 *
 * FRAMES are interpolated from `evidence.frames`, so page-versus-record drift
 * is impossible by construction rather than merely detected. That is the
 * stronger guarantee, and it is the right one here: a frame is 120 columns of
 * terminal output where a single retyped space is invisible to a reader and
 * fatal to the alignment. The gate's frame half therefore checks what is left
 * to check — that every `data-tt-frame` key on the page resolves to a stored
 * frame, and that every stored line is pure ASCII.
 */
const src = evidence.source;
---
<Base
  title="telltale · Gauges That Refuse to Guess · San Lee"
  description="A terminal instrument for five coding-agent CLIs, built on one rule: a value nobody measured renders as absent, never as zero."
  canonical="https://sanlee.me/projects/telltale.html"
  ogType="article"
  ogImage="/assets/og-telltale.png"
>
  <Fragment slot="head">
  <style is:inline>
    /* A terminal frame is an artifact, not prose: column alignment IS the
       content, so the shared `.article-body pre` rule (white-space: pre-wrap;
       overflow-wrap: anywhere) must be turned off here. Without this the frame
       is silently garbled, worst at 320px, and no gate fails. A frame wider
       than the column scrolls inside its own box; the page never scrolls. */
    /* The selector must out-rank `.article-body pre`, not merely follow it.
       A bare `.tt-frame` is one class against one class plus one element, so
       the shared rule wins on specificity no matter what order the sheets are
       in — and the failure is silent: the frame wraps, every column shears,
       and the mobile gate goes GREEN because a wrapped frame cannot overflow.
       Measured that way once, at 320px, before this selector was qualified. */
    .article-body pre.tt-frame {
      white-space: pre;
      overflow-x: auto;
      overflow-wrap: normal;
      max-width: 100%;
    }
    /* `overflow-x: auto` LOOKS like it already prevents the page from
       scrolling sideways, and on this layout it does not. `main.wrap` is the
       breakout grid (ADR-008), so the figure is a grid item, and a grid item's
       default `min-width: auto` refuses to shrink below its content — an
       unwrappable 120-column frame therefore widens its own track and takes
       the page with it. Measured before this rule: 60px of horizontal overflow
       at 320px and 20px at 360px, on a page whose scroll box was already
       declared. Both the item and the box need an explicit zero. */
    .tt-figure,
    .article-body pre.tt-frame { min-width: 0; }
    /* The caption names a full repository path, which is one long unbreakable
       token in a mono face. It must be allowed to break, or it reproduces the
       same overflow one element further down. */
    .tt-figure figcaption code { overflow-wrap: anywhere; }

    /* Argument plate TT-1 (portfolio ADR-004, ADR-012). Page-scoped: the three
       states a gauge can be in, and the fact that only two of them are honest.
       Drawn from internal/hud/testdata/golden/zero-vs-absent.txt at 38f262a,
       which is the strongest artifact in that repository and CANNOT be pasted:
       it carries four distinct non-ASCII characters and has no ASCII twin, so
       a paste would fail the font-coverage gate. This plate carries the
       argument instead, and it carries no number that could go stale.
       State is word plus geometry first, colour second. Oxide marks the
       negative finding, which here is the invented reading. Max-width 260
       keeps viewBox units 1:1 with CSS px (same discipline as .seam-plate).
       ADR-010 N/A: nothing here is interactive. */
    .tt-plate {
      display: block;
      width: 100%;
      max-width: 260px;
      height: auto;
      margin: 18px 0 6px;
    }
    .tt-plate .tt-track {
      fill: var(--bg);
      stroke: var(--rule-strong);
      stroke-width: 1;
    }
    .tt-plate .tt-fill {
      fill: var(--accent-warm-soft);
      stroke: var(--accent-warm);
      stroke-width: 1;
    }
    .tt-plate .tt-strike {
      fill: none;
      stroke: var(--accent-warm);
      stroke-width: 1.5;
    }
    .tt-plate .tt-value {
      fill: var(--text);
      font-family: var(--mono);
      font-size: 13px;
      font-weight: 600;
    }
    .tt-plate .tt-value-absent {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 13px;
      font-weight: 600;
    }
    .tt-plate .tt-value-bad {
      fill: var(--accent-warm);
      font-family: var(--mono);
      font-size: 13px;
      font-weight: 600;
    }
    .tt-plate .tt-state {
      fill: var(--text);
      font-family: var(--font);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.08em;
    }
    .tt-plate .tt-state-absent { fill: var(--muted); }
    .tt-plate .tt-state-bad { fill: var(--accent-warm); }
    .tt-plate .tt-micro {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 8px;
    }
    .tt-plate-caption {
      color: var(--muted);
      font-size: 0.92rem;
      margin: 0 0 18px;
    }
  </style>
