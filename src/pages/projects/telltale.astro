---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import evidence from '../../data/telltale-evidence.json';
/*
 * The page reads the record at render time in two places. Each place has a
 * different protection, on purpose.
 *
 * FIGURES are typed into the markup as literals. `check-telltale-evidence.cjs`
 * then compares the rendered text to this file, so the gate does real work: a
 * mistyped count fails the build. An interpolated figure would make the gate
 * compare the record to itself, and that is not a check.
 *
 * FRAMES are interpolated from `evidence.frames`. Page-versus-record drift is
 * therefore impossible by construction, not merely detected. That is the
 * stronger guarantee and it is the right one here. A frame is up to 120 columns
 * of terminal output. One retyped space is invisible to a reader and fatal to
 * the alignment. The gate's frame half checks what is left to check: every
 * `data-tt-frame` key on the page resolves to a stored frame, and every stored
 * line is pure ASCII.
 *
 * THE READER'S ORDER IS DECLARED HERE, NOT DERIVED FROM THE RECORD. The record
 * is a map and its key order is an accident of the puller. The reading order is
 * an argument: a reading, then a marked stale reading, then an absence, then
 * the record's reach, then the gate that spends a quota, then the refusal, and
 * last the phone-native twin. `scripts/pull-telltale-evidence.cjs` owns which
 * frames exist. This page owns the order they are read in.
 */
const src = evidence.source;
const READER_ORDER = ['usage', 'stale', 'absent', 'record', 'gate', 'floor', 'composer'];
const missingFrames = READER_ORDER.filter((k) => !evidence.frames[k]);
if (missingFrames.length) {
  // A frame the record no longer holds must stop the build here. Rendering the
  // reader without it would drop a caption and an argument in silence.
  throw new Error(
    `telltale.astro: the frame reader names ${missingFrames.join(', ')}, which `
    + 'src/data/telltale-evidence.json does not hold. Re-run '
    + 'scripts/pull-telltale-evidence.cjs, or correct READER_ORDER.'
  );
}
