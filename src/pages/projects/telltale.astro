        <text class="tt9-label" x="35" y="32" text-anchor="middle">RECORD</text>
        <text class="tt9-note" x="35" y="45" text-anchor="middle">ON DISK</text>

        <path class="tt9-edge" d="M 70 35 L 84 35" marker-end="url(#tt9-arrow)" aria-hidden="true" />

        <rect class="tt9-band" x="87" y="16" width="68" height="38" rx="2" aria-hidden="true" />
        <text class="tt9-label" x="121" y="32" text-anchor="middle">SWEEP</text>
        <text class="tt9-note" x="121" y="45" text-anchor="middle">A PATTERN</text>

        <path class="tt9-edge" d="M 156 35 L 170 35" marker-end="url(#tt9-arrow)" aria-hidden="true" />

        <rect class="tt9-box-warm" x="173" y="16" width="86" height="38" rx="2" aria-hidden="true" />
        <text class="tt9-label tt9-warm" x="216" y="32" text-anchor="middle">REPORTED</text>
        <text class="tt9-note tt9-warm" x="216" y="45" text-anchor="middle">NOTHING FOUND</text>

        <path class="tt9-band" d="M 35 62 L 35 54" aria-hidden="true" />
        <!-- This cell holds "WEEKS EARLIER", which measures 72 units at the 9px
