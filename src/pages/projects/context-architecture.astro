      <span class="fig-label">Plate 01</span>
      <svg class="ca1-plate ca-plate" viewBox="0 0 260 72" role="img"
           aria-label="One payload, three costs. Money: every resident token is re-sent on every turn. Attention: the model weights each fact less. Trust: a fact carries no date.">
        <title>A bigger payload is not free: money, attention, and trust.</title>
        <rect class="ca-box" x="2" y="4" width="76" height="44" rx="2" />
        <text class="ca-title" x="40" y="20" text-anchor="middle">Money</text>
        <text class="ca-micro" x="40" y="33" text-anchor="middle">re-sent on</text>
        <text class="ca-micro" x="40" y="43" text-anchor="middle">every turn</text>
        <rect class="ca-box" x="92" y="4" width="76" height="44" rx="2" />
        <text class="ca-title" x="130" y="20" text-anchor="middle">Attention</text>
        <text class="ca-micro" x="130" y="33" text-anchor="middle">each fact</text>
        <text class="ca-micro" x="130" y="43" text-anchor="middle">weighted less</text>
        <rect class="ca-box" x="182" y="4" width="76" height="44" rx="2" />
        <text class="ca-title" x="220" y="20" text-anchor="middle">Trust</text>
        <text class="ca-micro" x="220" y="33" text-anchor="middle">a fact has</text>
        <text class="ca-micro" x="220" y="43" text-anchor="middle">no date</text>
