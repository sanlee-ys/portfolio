          </marker>
          <marker id="sp-arrow-bad" viewBox="0 0 10 10" refX="9" refY="5"
                  markerWidth="6" markerHeight="6" orient="auto" aria-hidden="true">
            <path class="sp-head-bad" d="M 0 0 L 10 5 L 0 10 z" />
          </marker>
        </defs>

