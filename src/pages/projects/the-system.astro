          </marker>
        </defs>

        <text class="sp-era" x="4" y="10">THEN</text>

        <text class="sp-lane" x="4" y="28">PROVIDER</text>
        <rect class="sp-box" x="4" y="34" width="110" height="34" rx="2" />
        <text class="sp-title" x="59" y="55" text-anchor="middle">own fixture</text>
        <rect class="sp-ok" x="4" y="74" width="110" height="22" rx="2" />
