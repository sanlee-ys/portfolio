        <rect class="sp-box" x="4" y="18" width="110" height="36" rx="2" />
        <text class="sp-title" x="59" y="40" text-anchor="middle">own fixture</text>
        <rect class="sp-ok" x="4" y="60" width="110" height="22" rx="2" />
        <text class="sp-ok-text" x="59" y="75" text-anchor="middle">GREEN</text>

        <text class="sp-lane" x="146" y="12">CONSUMER</text>
        <rect class="sp-box" x="146" y="18" width="110" height="36" rx="2" />
        <text class="sp-title" x="201" y="40" text-anchor="middle">own stub</text>
        <rect class="sp-ok" x="146" y="60" width="110" height="22" rx="2" />
        <text class="sp-ok-text" x="201" y="75" text-anchor="middle">GREEN</text>

        <path class="sp-edge" d="M 59 82 L 59 96" marker-end="url(#sp-arrow)" aria-hidden="true" />
        <path class="sp-edge" d="M 201 82 L 201 96" marker-end="url(#sp-arrow)" aria-hidden="true" />
        <path class="sp-edge-break" d="M 59 96 L 118 96" aria-hidden="true" />
