  <style is:inline>
    /* Eval-rebuild plate (portfolio ADR-004). Page-scoped: the argument of
       this page is that the number fell when the gold got real, and that
       the lower figure is the trustworthy one. Not a metrics chart — the
       table below already carries every column. Max-width 260 keeps viewBox
       units 1:1 with CSS px on every gate width (same measured discipline
       as .judge-plate / .two-fail / .lab-topo). */
    .eval-plate {
      display: block;
      width: 100%;
      max-width: 260px;
      height: auto;
      margin: 18px 0 6px;
    }
    .eval-plate .ep-box {
      fill: var(--bg);
      stroke: var(--rule-strong);
      stroke-width: 1;
    }
    .eval-plate .ep-lane {
      fill: var(--muted);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    .eval-plate .ep-title {
      fill: var(--text);
      font-family: var(--font);
      font-size: 11px;
      font-weight: 500;
    }
    .eval-plate .ep-figure {
      fill: var(--text);
      font-family: var(--font);
      font-size: 16px;
      font-weight: 500;
    }
    .eval-plate .ep-micro {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 8px;
    }
    .eval-plate .ep-edge {
      fill: none;
      stroke: var(--muted);
      stroke-width: 1.5;
    }
    /* Flattering: ink solid — the ordinary (and wrong) reading. Dual-encoded
       by word + stroke. */
    .eval-plate .ep-ok {
      fill: var(--bg);
      stroke: var(--text);
      stroke-width: 1.5;
    }
    .eval-plate .ep-ok-text {
      fill: var(--text);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    /* Trustworthy: oxide — the drop is the finding. Word + oxide dual-encode;
       not colour-only. Oxide is for the negative result, same as .two-fail
       FAIL and .judge-plate UNSUPPORTED. */
    .eval-plate .ep-drop {
      fill: var(--accent-warm-soft);
      stroke: var(--accent-warm);
      stroke-width: 1.5;
    }
    .eval-plate .ep-drop-text {
      fill: var(--accent-warm);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    .eval-plate marker path { fill: var(--muted); }
    .eval-plate-caption {
      color: var(--muted);
      font-size: 0.92rem;
      margin: 0 0 18px;
    }

    /* Actor-is-not-theater plate. The region misses clustered here:
       a US actor inferred as americas. Oxide on the bad inference. */
