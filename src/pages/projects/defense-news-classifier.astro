---
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import Term from '../../components/Term.astro';
import figures from '../../data/figures.json';

/* The plot geometry. scripts/build-plots.cjs computed every number below from
   a named artifact at a pinned commit, and this page interpolates them. It
   never types a coordinate, so the figure cannot drift from the measurement.
   `dncPower.artifact` and `dncPower.sha` also fill the caption, so the
   provenance line cannot disagree with the geometry above it. */
const dncPower = figures.plots?.['dnc1-power'];
if (!dncPower) {
  throw new Error(
    'defense-news-classifier: src/data/figures.json holds no "dnc1-power" plot. '
    + 'Run: node scripts/build-plots.cjs --repo=<path to defense-news-classifier>'
  );
}
const pw = dncPower.geometry;
const pwCommit = dncPower.sha.slice(0, 7);
---
<Base
  title="Evaluating an LLM Defense News Classifier · San Lee"
  description="I measured an LLM classifier against hand-labeled defense news. Evidence gates declined retrieval, premium routing, and multi-agent complexity."
  canonical="https://sanlee.me/projects/defense-news-classifier.html"
  ogType="article"
  ogImage="/assets/og-defense-news-classifier.png"
>
  <Fragment slot="head">
  <style is:inline>
    /* Eval-rebuild plate (portfolio ADR-004). Page-scoped: the argument of
       this page is that the number fell when the gold got real, and that
       the lower figure is the trustworthy one. Not a metrics chart — the
       table below already carries every column.

       The width policy moved to the figure ladder in style.css (ADR-014).
       A `.fig.fig--plate` wraps the plate, and the plate hangs at
       --fig-plate. This lane deletes the old 260px cap. It does not
       out-cascade it. The plate now renders above 1:1, so the DECLARED
       units below hold the microtext floor. The render scale does not. */
    .eval-plate .ep-box {
      fill: var(--bg);
      stroke: var(--stroke-figure);
      stroke-width: 1;
    }
    .eval-plate .ep-lane {
      fill: var(--muted);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    .eval-plate .ep-title {
      fill: var(--text);
      font-family: var(--font);
      font-size: 11px;
      font-weight: 500;
    }
    .eval-plate .ep-figure {
      fill: var(--text);
      font-family: var(--font);
      font-size: 16px;
      font-weight: 500;
    }
    /* 9px, not 8px, for the microtext floor (CLAUDE.md, ADR-014 section 5).
       I measured 8.00px rendered at 320px before this change. */
    .eval-plate .ep-micro {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 9px;
    }
    .eval-plate .ep-edge {
      fill: none;
      stroke: var(--muted);
      stroke-width: 1.5;
    }
    /* Flattering: ink solid — the ordinary (and wrong) reading. Dual-encoded
       by word + stroke. */
    .eval-plate .ep-ok {
      fill: var(--bg);
      stroke: var(--text);
      stroke-width: 1.5;
    }
    .eval-plate .ep-ok-text {
      fill: var(--text);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    /* Trustworthy: oxide — the drop is the finding. Word + oxide dual-encode;
       not colour-only. Oxide is for the negative result, same as .two-fail
       FAIL and .judge-plate UNSUPPORTED. */
    .eval-plate .ep-drop {
      fill: var(--accent-warm-soft);
      stroke: var(--accent-warm);
      stroke-width: 1.5;
    }
    .eval-plate .ep-drop-text {
      fill: var(--accent-warm);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    .eval-plate marker path { fill: var(--muted); }

    /* Actor-is-not-theater plate. The region misses clustered here:
       a US actor inferred as americas. Oxide on the bad inference. The
       figure ladder sets the width policy, the same as .eval-plate above. */
    .theater-plate .th-box {
      fill: var(--bg);
      stroke: var(--stroke-figure);
      stroke-width: 1;
    }
    .theater-plate .th-lane {
      fill: var(--muted);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    .theater-plate .th-title {
      fill: var(--text);
      font-family: var(--font);
      font-size: 11px;
      font-weight: 500;
    }
    /* 9px for the microtext floor. I measured 8.00px at 320px before. */
    .theater-plate .th-micro {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 9px;
    }
    /* The one micro line that sits ON the oxide wash, not on the figure
       ground. The lifted dark figure ground (ADR-014) raised the composited
       wash, and --muted on it measured 3.51:1 at night. The metadata ink
       measures 4.89:1 there, so the annotation reads at the same apparent
       weight as its twin on the plain ground. No opacity, no new hue: a
       quieter thing gets a quieter token, never a faded one (ADR-009). */
    .theater-plate .th-micro-wash { fill: var(--text-secondary); }
    .theater-plate .th-edge {
      fill: none;
      stroke: var(--accent-warm);
      stroke-width: 1.5;
      stroke-dasharray: 4 3;
    }
    .theater-plate .th-ok {
      fill: var(--bg);
      stroke: var(--text);
      stroke-width: 1.5;
    }
    .theater-plate .th-ok-text {
      fill: var(--text);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    .theater-plate .th-bad {
      fill: var(--accent-warm-soft);
      stroke: var(--accent-warm);
      stroke-width: 1.5;
    }
    .theater-plate .th-bad-text {
      fill: var(--accent-warm);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    .theater-plate marker path { fill: var(--accent-warm); }

    /* The two-slot caption grammar left this island. style.css is its ONE
       home now (ADR-014). This lane deletes the copy that stood here, and
       its origin comment with it. It does not out-cascade them. The global
       home also carries the `figcaption code { overflow-wrap: anywhere }`
       rule that this page first needed for the artifact path in the
       dnc1-power caption.

       These two rules stay page-scoped because the consolidated home names
       no bare-plate caption class but telltale's. The VALUES are the
       consolidated grammar's, so both plates read in one voice with every
       two-slot caption on the site. */
    .eval-plate-caption,
    .theater-plate-caption {
      max-width: var(--content);
      margin: 14px auto 0;
      color: var(--muted);
      font-size: 0.95rem;
      line-height: 1.55;
    }

    /* dnc1-power. A PLOT: every x below is interpolated from
       src/data/figures.json, which scripts/build-plots.cjs computed from a
       named artifact at a pinned commit. No coordinate here is typed, which
       is what the <svg>'s data-fig-generated="true" declares.

       The SVG holds no digit. Both p-values sit in .fig-what beside the
       artifact that produced them, so the reader gets the number and its
       source in one place rather than a bare figure on a plate.

       The first run lands about one pixel left of the bar. That is the honest
       geometry -- it missed by 0.0022 -- so the VERDICT WORD carries the
       outcome and the position only supports it. */
    .dnc1-plot {
      display: block;
      width: 100%;
      /* A PLOT takes the plot rung of the figure ladder (ADR-014), which is
         why this rule survives the consolidation: style.css caps plates and
         leaves plots to the page. */
      max-width: min(100%, var(--fig-plot));
      height: auto;
      margin: 0 auto;
    }
    .dnc1-plot .dnc1-bar { stroke: var(--text); stroke-width: 1.5; }
    /* The axis track is the figure layer's STRONG rank, under the bar's ink
       (PL-10). It read --border, which is alpha ink now and too faint for a
       drawn axis at night. */
    .dnc1-plot .dnc1-track { stroke: var(--stroke-figure); stroke-width: 1; }
    .dnc1-plot .dnc1-lane {
      fill: var(--muted);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    /* 9px for the microtext floor. I measured 8.00px at 320px before. */
    .dnc1-plot .dnc1-note {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 9px;
    }
    /* Oxide is the site's mark for a decision that was taken back, the same
       encoding as .ep-drop above and .rung[data-state="retired"] on the
       ladder page. The soft fill is translucent, so the bar stays visible
       through the dot that straddles it. */
    .dnc1-plot .dnc1-dot-back {
      fill: var(--accent-warm-soft);
      stroke: var(--accent-warm);
      stroke-width: 1.5;
    }
    .dnc1-plot .dnc1-verdict-back {
      fill: var(--accent-warm);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }
    .dnc1-plot .dnc1-dot-kept {
      fill: var(--bg);
      stroke: var(--text);
      stroke-width: 1.5;
    }
    .dnc1-plot .dnc1-verdict-kept {
      fill: var(--text);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 700;
    }

    /* dnc2-inversion. Hand-drawn, so it carries no digit (ADR-013): the
       counts sit in .fig-what and in the prose below. What it shows is the
       DIRECTION of a miss, which is the one thing the prose can only state.
       Monochrome on purpose. Oxide on this site means a decision that was
       taken back, and a mislabeled row is not one. The two directions are
       dual-encoded by their own words and by the mirrored word order. */
    /* The figure ladder in style.css (ADR-014) sets the width, the height,
       and the centring: a `figure[data-fig="plate"] > svg` hangs at
       --fig-plate. This lane deletes the old 260px cap. It does not
       out-cascade it. */
    .dnc2-plate .dnc2-box {
      fill: var(--bg);
      stroke: var(--stroke-figure);
      stroke-width: 1;
    }
    .dnc2-plate .dnc2-row {
      fill: var(--bg);
      stroke: var(--text);
      stroke-width: 1;
    }
    .dnc2-plate .dnc2-lane {
      fill: var(--muted);
      font-family: var(--font);
      font-size: 10px;
      font-weight: 600;
      letter-spacing: 0.06em;
    }
    .dnc2-plate .dnc2-title {
      fill: var(--text);
      font-family: var(--font);
      font-size: 11px;
      font-weight: 500;
    }
    /* 9px per the microtext floor. Measured at 320px before: 8.37px. */
    .dnc2-plate .dnc2-micro {
      fill: var(--muted);
      font-family: var(--mono);
      font-size: 9px;
    }
    .dnc2-plate .dnc2-edge {
      fill: none;
      stroke: var(--muted);
      stroke-width: 1.5;
    }
    .dnc2-plate marker path { fill: var(--muted); }

    /* dnc-s1, the rung strip. HTML and CSS, not an SVG, so the four labels
       are the same text nodes p.flow-line carried and the contrast gate
       still reads them. The state vocabulary is the ladder page's own
       data-state, and "declined" is the word its .rung-plate already renders
       for L4. The state WORD carries the verdict; the rail colour only
       supports it, so no state is colour-only. .rung and .rung-state are
       global classes in style.css and these names do not collide with
       them. */
    .dncs1-rows {
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .dncs1-row {
      display: grid;
      grid-template-columns: 2.2rem 1fr auto;
      gap: 0 10px;
      align-items: baseline;
      min-width: 0;
      padding: 8px 0 8px 10px;
      border-left: 3px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .dncs1-row:last-child { border-bottom: 0; }
    .dncs1-row > span { min-width: 0; }
    .dncs1-id {
      font-family: var(--mono);
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--muted);
    }
    .dncs1-name { font-size: 0.95rem; }
    .dncs1-state {
      font-size: 0.72rem;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      border: 1px solid;
      border-radius: var(--radius-sm);
      padding: 1px 6px;
      white-space: nowrap;
    }
    .dncs1-row[data-state="shipped"] { border-left-color: var(--accent); }
    .dncs1-row[data-state="shipped"] .dncs1-id,
    .dncs1-row[data-state="shipped"] .dncs1-state { color: var(--accent); }
    .dncs1-row[data-state="shipped"] .dncs1-state { border-color: var(--accent); }
    .dncs1-row[data-state="retired"],
    .dncs1-row[data-state="declined"] { border-left-color: var(--accent-warm); }
    .dncs1-row[data-state="retired"] .dncs1-id,
    .dncs1-row[data-state="retired"] .dncs1-state,
    .dncs1-row[data-state="declined"] .dncs1-id,
    .dncs1-row[data-state="declined"] .dncs1-state { color: var(--accent-warm); }
    .dncs1-row[data-state="retired"] .dncs1-state,
    .dncs1-row[data-state="declined"] .dncs1-state { border-color: var(--accent-warm); }
  </style>
  </Fragment>

