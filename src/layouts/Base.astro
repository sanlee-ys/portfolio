---
// The page shell that was copied by hand into all 13 pages until 2026-07-26.
// Everything here used to be duplicated per file: the head, the theme
// bootstrap, the analytics snippet and the theme toggle. See `ADR-006`.
//
// Every <script> and <style> below carries `is:inline`. That is load-bearing,
// not decoration: without it Astro bundles and renames the asset, which would
// break the `public/` paths and hash the filenames the site already publishes.
// `social` gates the canonical + Open Graph + Twitter block. It defaults to
// "this page has a canonical URL", which is the same question. 404.html is the
// page that proves the gate is needed: it carries `noindex` and deliberately no
// canonical and no social tags, and an unconditional block gave it an empty
// `og:url` and a null canonical -- worse than emitting nothing.
const {
  title,
  description,
  canonical,
  robots,
  ogType = 'article',
  ogTitle = title,
  ogDescription = description,
  // Absolute path under the site root. Project pages pass a per-card PNG
  // (e.g. /assets/og-false-green.png); everything else keeps the homepage card.
  ogImage = '/assets/og-cover.png',
  social = canonical != null,
  // Where the skip link lands. Every page's <main> carries `id="main"` except
  // the homepage. Its <main> has been `id="work"` since before this existed
  // and the glossary deep-links it as `index.html#work`, so that id stays.
  // The homepage overrides the target with `#proof`, the proof band above
  // <main>, so a keyboard or screen-reader user who skips does not miss it.
  skipTo = '#main',
} = Astro.props;
const ogImageUrl = ogImage.startsWith('http') ? ogImage : `https://sanlee.me${ogImage}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {robots && <meta name="robots" content={robots} />}
  {canonical && <link rel="canonical" href={canonical} />}
  {social && (
    <Fragment>
      <meta property="og:site_name" content="San Lee" />
      <meta property="og:type" content={ogType} />
      <meta property="og:url" content={canonical} />
      <meta property="og:title" content={ogTitle} />
      <meta property="og:description" content={ogDescription} />
      <meta property="og:image" content={ogImageUrl} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={ogTitle} />
      <meta name="twitter:description" content={ogDescription} />
      <meta name="twitter:image" content={ogImageUrl} />
    </Fragment>
  )}
  <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/assets/favicon-16.png" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <!--
    The masthead, every paragraph and all of the chrome are set in Geist, so
    its latin roman is on the critical path for the largest element on the
    page AND for the nav. Without this the browser cannot discover it until
    style.css has been fetched AND parsed; the preload starts it in parallel
    with the stylesheet instead.

    This used to point at newsreader-latin.woff2. With the serif gone there is
    one text face rather than two, so the preload follows it -- and the thing
    being preloaded is now also the thing the chrome always needed, which is
    strictly a better bet than the old one was.

    Only the latin roman is preloaded -- the latin-ext subset and Geist Mono
    are wanted later or not at all on a given page, and a preload for a font
    the page never uses is a wasted request plus a console warning.
    `crossorigin` is required even same-origin: fonts are fetched in CORS
    mode, and a preload whose mode does not match the real request is simply
    downloaded twice.
  -->
  <link rel="preload" href="/assets/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/style.css" />
  <script is:inline>
    // Paper is the default. The record is a printed thing first and a lit one
    // second, so with nothing stored and no OS preference expressed this
    // resolves to "light" -- the inverse of what it did until the journal
    // pass, where anything short of an explicit OS "light" fell through to
    // dark. Precedence is unchanged and still puts the reader first: a stored
    // choice wins, then an explicit OS preference for dark, then paper. The
    // catch arm matches, so a browser with localStorage blocked gets paper
    // rather than the old hard-coded dark. The stylesheet's :root carries the
    // light tokens for the same reason -- if this script never runs at all,
    // the page is still paper rather than unstyled-dark.
    (function () {
      try {
        var saved = localStorage.getItem("theme");
        var t = saved || (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", t);
      } catch (e) { document.documentElement.setAttribute("data-theme", "light"); }
    })();
  </script>
<!-- Privacy-friendly analytics by Plausible -->
<script is:inline async src="https://plausible.io/js/pa-ka6NxL3Pt5fcGylyI63YV.js"></script>
<script is:inline>
  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
  plausible.init()
</script>
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href={skipTo}>Skip to content</a>
  <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false" title="Switch to dark theme">
    <span class="theme-icon-dark">&#9789;</span>
    <span class="theme-icon-light">&#9728;</span>
  </button>
  <slot />
  <!-- Glossary tooltip layer (Term.astro). One element per page, shared by
       every a.term; the script below is a no-op on pages that have none.
       The anchor's own navigation is the tap behavior -- this never calls
       preventDefault or scrollIntoView (see "A figure offers the jump"). -->
  <div id="term-tip" role="tooltip" hidden></div>
  <script is:inline>
    (function () {
      var tip = document.getElementById("term-tip");
      var anchors = document.querySelectorAll("a.term");
      if (!tip || anchors.length === 0) { if (tip) tip.remove(); return; }
      var active = null;
      var GAP = 8;

      function place(anchor) {
        var a = anchor.getBoundingClientRect();
        var t = tip.getBoundingClientRect();
        // Below the anchor by default; flip above only when there is no room
        // below and there is room above. Never covers the term either way.
        var top = a.bottom + GAP;
        if (top + t.height > window.innerHeight - GAP && a.top - t.height - GAP >= GAP) {
          top = a.top - t.height - GAP;
        }
        // Clamp horizontally so the tooltip can never overflow the viewport;
        // its max-width leaves 2rem spare, so the clamp always has room.
        var left = a.left + a.width / 2 - t.width / 2;
        left = Math.max(GAP, Math.min(left, window.innerWidth - t.width - GAP));
        tip.style.top = top + "px";
        tip.style.left = left + "px";
      }

      function show(anchor) {
        var text = anchor.getAttribute("data-tip");
        if (!text) return;
        tip.textContent = text;
        tip.hidden = false;
        place(anchor);
        // Focusing an off-screen anchor makes the browser scroll it into
        // view AFTER focusin has run, which would strand a fixed-position
        // tooltip where the anchor used to be. Re-place on the next frame.
        requestAnimationFrame(function () { if (active === anchor) place(anchor); });
        anchor.setAttribute("aria-describedby", "term-tip");
        active = anchor;
      }

      function hide() {
        tip.hidden = true;
        if (active) { active.removeAttribute("aria-describedby"); active = null; }
      }

      for (var i = 0; i < anchors.length; i++) {
        anchors[i].addEventListener("mouseenter", function (e) { show(e.currentTarget); });
        anchors[i].addEventListener("focusin", function (e) { show(e.currentTarget); });
        anchors[i].addEventListener("mouseleave", hide);
        anchors[i].addEventListener("focusout", hide);
      }
      // Escape dismisses the tooltip and nothing else: focus stays put.
      document.addEventListener("keydown", function (e) {
        if (e.key === "Escape" && !tip.hidden) hide();
      });
      // Scrolling with the tooltip open: keep it on its anchor. This reads
      // geometry only; it never scrolls anything itself.
      window.addEventListener("scroll", function () { if (active) place(active); }, { passive: true });
    })();
  </script>
</body>
</html>
