---
// The page shell that was copied by hand into all 13 pages until 2026-07-26.
// Everything here used to be duplicated per file: the head, the theme
// bootstrap, the analytics snippet and the theme toggle. See `ADR-006`.
//
// Every <script> and <style> below carries `is:inline`. That is load-bearing,
// not decoration: without it Astro bundles and renames the asset, which would
// break the `public/` paths and hash the filenames the site already publishes.
// `social` gates the canonical + Open Graph + Twitter block. It defaults to
// "this page has a canonical URL", which is the same question. 404.html is the
// page that proves the gate is needed: it carries `noindex` and deliberately no
// canonical and no social tags, and an unconditional block gave it an empty
// `og:url` and a null canonical -- worse than emitting nothing.
const {
  title,
  description,
  canonical,
  robots,
  ogType = 'article',
  ogTitle = title,
  ogDescription = description,
  social = canonical != null,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {robots && <meta name="robots" content={robots} />}
  {canonical && <link rel="canonical" href={canonical} />}
  {social && (
    <Fragment>
      <meta property="og:site_name" content="San Lee" />
      <meta property="og:type" content={ogType} />
      <meta property="og:url" content={canonical} />
      <meta property="og:title" content={ogTitle} />
      <meta property="og:description" content={ogDescription} />
      <meta property="og:image" content="https://sanlee.me/assets/og-cover.png" />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={ogTitle} />
      <meta name="twitter:description" content={ogDescription} />
      <meta name="twitter:image" content="https://sanlee.me/assets/og-cover.png" />
    </Fragment>
  )}
  <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="icon" href="/assets/favicon-16.png" sizes="16x16" type="image/png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <!--
    The masthead and every paragraph on the site are set in Newsreader, so the
    roman is on the critical path for the largest element on the page. Without
    this the browser cannot discover it until style.css has been fetched AND
    parsed; the preload starts it in parallel with the stylesheet instead.
    Only the roman is preloaded -- the italic, the two latin-ext subsets and
    both Geist families are wanted later or not at all on a given page, and a
    preload for a font the page never uses is a wasted request plus a console
    warning. `crossorigin` is required even same-origin: fonts are fetched in
    CORS mode, and a preload whose mode does not match the real request is
    simply downloaded twice.
  -->
  <link rel="preload" href="/assets/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/assets/style.css" />
  <script is:inline>
    // Paper is the default. The record is a printed thing first and a lit one
    // second, so with nothing stored and no OS preference expressed this
    // resolves to "light" -- the inverse of what it did until the journal
    // pass, where anything short of an explicit OS "light" fell through to
    // dark. Precedence is unchanged and still puts the reader first: a stored
    // choice wins, then an explicit OS preference for dark, then paper. The
    // catch arm matches, so a browser with localStorage blocked gets paper
    // rather than the old hard-coded dark. The stylesheet's :root carries the
    // light tokens for the same reason -- if this script never runs at all,
    // the page is still paper rather than unstyled-dark.
    (function () {
      try {
        var saved = localStorage.getItem("theme");
        var t = saved || (window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", t);
      } catch (e) { document.documentElement.setAttribute("data-theme", "light"); }
    })();
  </script>
<!-- Privacy-friendly analytics by Plausible -->
<script is:inline async src="https://plausible.io/js/pa-ka6NxL3Pt5fcGylyI63YV.js"></script>
<script is:inline>
  window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
  plausible.init()
</script>
  <slot name="head" />
</head>
<body>
  <button id="theme-toggle" class="theme-toggle" aria-label="Toggle light/dark theme" title="Toggle theme">
    <span class="theme-icon-dark">&#9789;</span>
    <span class="theme-icon-light">&#9728;</span>
  </button>
  <slot />
</body>
</html>
